meta {
  name: F-2 · Ana · estado=Completada
  type: http
  seq: 3
}

get {
  url: {{host}}/transacciones/filtrar?estado=Completada
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

tests {
  test("F-2 responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("F-2 todas son de Ana", function () {
    expect(res.getBody().data.every(x => [1, 2].includes(x.comercio_id))).to.be.true;
  });
  
  test("F-2 todas estan Completadas", function () {
    expect(res.getBody().data.every(x => x.estado === "Completada")).to.be.true;
  });
}

docs {
  Esperado: 200 con solo las transacciones de Ana.

  Es el problema ③. La versión de la IA arrancaba en Transaccion::query(), o sea
  la tabla completa, así que Ana veía también los cobros de Carlos. La prueba no
  mira solo el código de estado: mira de quién son las filas que volvieron.
}
