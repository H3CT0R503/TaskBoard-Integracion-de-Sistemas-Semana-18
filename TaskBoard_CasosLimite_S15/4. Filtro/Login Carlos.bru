meta {
  name: Login Carlos (para F-3)
  type: http
  seq: 1
}

post {
  url: {{host}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "carlos@taskboard.test",
    "password": "password123",
    "dispositivo": "bruno-filtro-carlos"
  }
}

script:post-response {
  bru.setVar("tokenCarlos", res.getBody().token);
}

tests {
  test("Login Carlos responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  La segunda identidad, que hace falta para F-3.

  Sin dos usuarios no se puede comprobar el aislamiento: con uno solo, una
  lista vacia o una lista corta no prueban nada.
}
